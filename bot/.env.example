# Telegram Bot Token (BotFather'dan al)
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=YourBotUsername

# Public bot handle used in ad footer ("Reklama | @<handle>")
# Read by services/telegram_sender.py; defaults to "aimaa_ads_bot" if unset.
PLATFORM_BOT_USERNAME=aimaa_ads_bot

# Backend API URL
BACKEND_API=http://localhost:8000/api

# Bot Secret (Backend .env'deki BOT_API_SECRET ile aynı olmalı!)
BOT_SECRET=your_bot_api_secret_here
